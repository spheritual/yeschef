  <diagram id="page1" name="1 System context">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0" background="#F8F5EC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3" value="1. System context" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#263B2E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Who and what yeschef! talks to. Solid lines are in the demo; dashed boxes are planned for after the hackathon. Everything not shown stays on the phone, and the demo keeps its data in memory only." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#73796B;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Home cook" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFEF8;strokeColor=#263B2E;fontColor=#263B2E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="50" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;yeschef!&lt;/b&gt;&lt;br&gt;iPhone app (Swift and SwiftUI)&lt;br&gt;&lt;br&gt;Plans the week's dinners, teaches each recipe step by step through Basil the chef, and learns the household's tastes." style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#386347;fontColor=#FFFFFF;strokeColor=#263B2E;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="330" y="230" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Gemini API&lt;/b&gt; (Google)&lt;br&gt;Serves Gemma 4, gemma-4-26b-a4b-it, an open-weight model under Apache 2.0" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#E7ECCD;" vertex="1" parent="1">
          <mxGeometry x="900" y="140" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;iOS frameworks on the phone&lt;/b&gt;&lt;br&gt;Speech for voice questions, AVSpeechSynthesizer for Basil's voice, PhotosUI for recipe photos, UserNotifications for timers" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#E7ECCD;" vertex="1" parent="1">
          <mxGeometry x="900" y="320" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Calendar (EventKit) and Apple Health&lt;br&gt;planned" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#FFFFFF;dashed=1;fontColor=#73796B;strokeColor=#73796B;" vertex="1" parent="1">
          <mxGeometry x="330" y="520" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Grocery store deals and pickup orders&lt;br&gt;planned, APIs unverified" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#FFFFFF;dashed=1;fontColor=#73796B;strokeColor=#73796B;" vertex="1" parent="1">
          <mxGeometry x="900" y="520" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="talks, taps, cooks and rates" style="html=1;endArrow=block;endFill=1;strokeColor=#263B2E;fontColor=#263B2E;fontSize=11;labelBackgroundColor=#F8F5EC;" edge="1" parent="1" source="c5" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="HTTPS: plans, recipes, photo reads, answers" style="html=1;endArrow=block;endFill=1;strokeColor=#263B2E;fontColor=#263B2E;fontSize=11;labelBackgroundColor=#F8F5EC;" edge="1" parent="1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="on-device calls" style="html=1;endArrow=block;endFill=1;strokeColor=#263B2E;fontColor=#263B2E;fontSize=11;labelBackgroundColor=#F8F5EC;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
