        <mxCell id="c4" value="The feedback loop from .plans/feedback-learning-spec.md. Allergy rules always run before the model, and every rating, cook, swap or skip changes the next plan." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#73796B;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="ellipse;html=1;fillColor=#263B2E;strokeColor=#263B2E;" vertex="1" parent="1">
          <mxGeometry x="110" y="130" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Gemma suggests 3 dinners per day" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Hard rules remove allergens and dislikes" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Any safe idea left?" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rhombus;fillColor=#E7ECCD;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="420" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Drop the day, or Basil asks again" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="300" y="435" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Encode 15 features with the day's context" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="Each member's model draws weights; scores are averaged" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Top idea is the pick; the rest are swaps" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="The cook sees the plan" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="320" y="800" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="What happens?" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rhombus;fillColor=#E7ECCD;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="785" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="Rated 1 to 5 stars: reward 0 to 1" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="800" y="640" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="Cooked: reward 0.8" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="800" y="730" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="Skipped: reward 0.3" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="800" y="820" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="Swapped out: reward 0.1" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="800" y="910" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="Each member's model updates, older feedback decays by 0.97" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=30;fillColor=#FFFEF8;" vertex="1" parent="1">
