        <mxCell id="c11" value="&lt;b&gt;ImportView&lt;/b&gt;&lt;br&gt;pick a recipe photo" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Voice&lt;/b&gt;&lt;br&gt;MicButton, BasilVoice" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="560" y="350" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b&gt;AppModel&lt;/b&gt; (@Observable, shared state)&lt;br&gt;household, busy days, plan, recipe, mood, subtitle, messages, one PreferenceModel per member&lt;br&gt;planWeek(), open(), ask(), importRecipe(), record(), retry()" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#FFFEF8;" vertex="1" parent="1">
