        <mxCell id="c3" value="2. Containers and components" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#263B2E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1640" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="The app target holds the screens and anything that needs an Apple-only framework. YesChefCore holds the Gemma calls and the learning, has no UI, and builds and tests on the Mac and on Linux. Screens never call Gemma themselves; they go through AppModel." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#73796B;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1640" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="YesChef app target (SwiftUI, builds in Xcode)" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=4;fillColor=#F8F5EC;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="780" height="720" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Screens&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=6;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;MainScreen&lt;/b&gt;&lt;br&gt;BasilView and BasilStage, SubtitleBar, BurgerButton and BurgerMenu, LearningCard" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;MenuPages&lt;/b&gt;&lt;br&gt;This week (DayCard), RecipesPage, ShoppingListPage, HouseholdPage, SettingsPage" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#FFFEF8;" vertex="1" parent="1">
          <mxGeometry x="320" y="220" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;CookModeView&lt;/b&gt;&lt;br&gt;one step at a time, step timers with notifications, RatingSheet at the end" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#FFFEF8;" vertex="1" parent="1">
