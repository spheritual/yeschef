        <mxCell id="c4" value="What each folder in the repo holds. gummi-main is another project's code that a teammate committed as reference; it isn't part of yeschef!." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#73796B;" vertex="1" parent="1">
