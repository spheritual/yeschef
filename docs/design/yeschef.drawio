        <mxCell id="c14" value="&lt;b&gt;Theme&lt;/b&gt; and &lt;b&gt;AppSecrets&lt;/b&gt;&lt;br&gt;colors and fonts from design/tokens.json; the Gemini key from Config/Secrets.xcconfig" style="html=1;whiteSpace=wrap;fontColor=#263B2E;strokeColor=#386347;fontSize=13;rounded=1;arcSize=12;fillColor=#FFFEF8;" vertex="1" parent="1">
